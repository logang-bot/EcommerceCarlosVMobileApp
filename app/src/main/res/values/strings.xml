    <!-- Ayuda -->
    <string name="help_title">Ayuda</string>
    <string name="help_topic_inicio_title">Primeros pasos</string>
    <string name="help_topic_inicio_body">Inicia sesión con tu correo y contraseña. Si ya activaste el acceso con huella dactilar, podrás entrar sin escribirla la próxima vez. Tu rol (Superusuario, Usuario o Invitado) determina qué puedes ver y editar dentro de la app.</string>
    <string name="help_topic_mercados_title">Mercados</string>
    <string name="help_topic_mercados_body">Un mercado agrupa a los clientes de una misma zona o punto de venta. Desde la pantalla principal puedes ver todos los mercados, crear uno nuevo y entrar a cada uno para ver sus clientes.</string>
    <string name="help_topic_clientes_title">Clientes</string>
    <string name="help_topic_clientes_body">Dentro de un mercado puedes ver la lista de clientes con su estado de cuenta: Al día (verde), Cobrar (amarillo) o Crítico (rojo), según el saldo pendiente y los umbrales configurados. Toca un cliente para ver su historial de pedidos y su saldo.</string>
    <string name="help_topic_pedidos_title">Pedidos</string>
    <string name="help_topic_pedidos_body">Cada pedido registra los productos entregados a un cliente. Puedes crear un pedido desde el detalle del cliente, agregar productos del catálogo o líneas manuales, y marcar pagos totales o parciales. También puedes registrar un saldo extra fuera de un pedido.</string>
    <string name="help_topic_productos_title">Catálogo de productos</string>
    <string name="help_topic_productos_body">El catálogo es compartido por todos los usuarios. Ahí puedes agregar productos con nombre, precio, costo, foto y existencias, para usarlos rápidamente al armar un pedido.</string>
    <string name="help_topic_lista_negra_title">Lista negra</string>
    <string name="help_topic_lista_negra_body">Si un cliente deja de pagar, puedes agregarlo a la lista negra desde su detalle, indicando el motivo y el monto adeudado. La lista negra reúne a los clientes marcados de todos los mercados, y puedes quitarlos cuando su situación se resuelva.</string>
    <string name="help_topic_reportes_title">Reportes</string>
    <string name="help_topic_reportes_body">En la pestaña Reporte puedes consultar totales diarios o por cliente, filtrar por fecha y exportar el resultado en PDF para compartirlo o imprimirlo.</string>
    <string name="help_topic_sincronizacion_title">Sincronización sin conexión</string>
    <string name="help_topic_sincronizacion_body">La app funciona sin internet: todo lo que registras se guarda primero en el dispositivo y se sincroniza automáticamente al recuperar conexión. El ícono de la nube en la barra superior indica si hay cambios pendientes por enviar.</string>
    <string name="help_topic_seguridad_title">Seguridad y contraseña</string>
    <string name="help_topic_seguridad_body">Desde Mi Perfil → Seguridad puedes activar el acceso con huella dactilar y cambiar tu contraseña. Los superusuarios también pueden restablecer la contraseña de otros usuarios desde su detalle.</string>
    <string name="help_topic_equipo_title">Gestión de usuarios</string>
    <string name="help_topic_equipo_body">Los superusuarios pueden crear cuentas de equipo, cambiar roles y activar o desactivar miembros desde Mi Perfil → Equipo, y ajustar los umbrales de estado de los clientes desde Ajustes.</string>

    <!-- Umbrales de estado -->
    <string name="umbrales_title">Umbrales de estado</string>
    <string name="umbrales_header">El estado se decide sobre todo por <b>cuánto tiempo lleva sin pagarse</b> la deuda — no por el monto. Configura cuándo un cliente pasa a <b>Crítico</b>; lo demás se calcula solo.</string>
    <string name="umbrales_al_dia_desc">El cliente no debe nada: su balance es Bs. 0.</string>
    <string name="umbrales_advertencia_desc">Debe dinero, pero todavía no llega a Crítico. Cualquier saldo mayor a Bs. 0 empieza aquí.</string>
    <string name="umbrales_critico_desc">Se marca en rojo cuando ocurre cualquiera de estas dos cosas:</string>
    <string name="umbrales_automatico">Automático</string>
    <string name="umbrales_monto_maximo">Monto máximo</string>
    <string name="umbrales_monto_hint">Si el balance del cliente pasa este monto, entra en Crítico al instante.</string>
    <string name="umbrales_monto_prefix">Más de  ·  Bs.</string>
    <string name="umbrales_dias_label">Días sin pagar</string>
    <string name="umbrales_dias_hint">Cuenta los días desde que se generó una deuda que aún no se salda.</string>
    <string name="umbrales_dias_prefix">Más de</string>
    <string name="umbrales_dias_suffix">días</string>
    <string name="umbrales_or_connector">O</string>
    <string name="umbrales_info_note">La antigüedad solo cuenta sobre deuda que ya suma al balance: abonos parciales y saldos extra pendientes. Un pedido pendiente normal nunca se marca como deuda vencida, por más viejo que sea.</string>
    <string name="umbrales_guardar">Guardar umbrales</string>

