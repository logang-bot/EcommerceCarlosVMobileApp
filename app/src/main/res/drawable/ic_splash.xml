<?xml version="1.0" encoding="utf-8"?>
<!-- Without gravity the bitmap scales to fill its bounds; insets control the final display size -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="30dp"
        android:bottom="30dp"
        android:left="30dp"
        android:right="30dp">
        <bitmap android:src="@drawable/img_logo" />
    </item>
</layer-list>
