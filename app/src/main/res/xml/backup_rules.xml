<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for API 24-30 (android:fullBackupContent).
   API 31+ is governed by data_extraction_rules.xml instead.

   Nothing about this app may be backed up. The data dir holds a long-lived Supabase refresh
   token, and the rest is a cache of Supabase that re-syncs after login. See the comment above
   <application> in AndroidManifest.xml.

   NOTE: an EMPTY <full-backup-content> means "back up everything" — which is exactly the bug
   this file used to have. The exclude below is required; do not delete it.
-->
<full-backup-content>
    <exclude domain="root" path="." />
</full-backup-content>
