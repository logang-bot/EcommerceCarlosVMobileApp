<?xml version="1.0" encoding="utf-8"?><!--
   Backup / transfer rules for API 31+ (android:dataExtractionRules).
   API 24-30 is governed by backup_rules.xml instead.

   Nothing about this app may leave the device. The data dir holds a long-lived Supabase refresh
   token, and the rest is a cache of Supabase that re-syncs after login. See the comment above
   <application> in AndroidManifest.xml.

   <device-transfer> is NOT optional: android:allowBackup="false" disables cloud backup but does
   NOT stop device-to-device transfer on API 31+, which is governed solely by this block.

   NOTE: an EMPTY section means "include everything" — which is exactly the bug this file used to
   have. Both excludes below are required; do not delete them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
